{
  "name": "thinclock",
  "version": "0.1.0",
  "description": "Thin, config-driven ESP32 LED matrix firmware. JSON in, pixels out.",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "build": "cd firmware && ~/.platformio/penv/bin/pio run",
    "flash": "cd firmware && ~/.platformio/penv/bin/pio run -t upload",
    "erase": "cd firmware && python3 ~/.platformio/packages/tool-esptoolpy/esptool.py --port ${PORT:-/dev/cu.usbserial-204310} erase_flash",
    "flash:force": "npm run erase && npm run flash",
    "monitor": "cd firmware && ~/.platformio/penv/bin/pio device monitor --baud 115200",
    "setup": "npm install && echo 'Copy .env.example to .env and fill in your values'",
    "start": "node src/server.js",
    "postinstall": "node scripts/setup.js",
    "test": "node scripts/test.js",
    "spec": "node scripts/spec.js",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "express": "^5.2.1",
    "hybrids": "^9.1.22",
    "lucide-static": "^1.7.0",
    "ws": "^8.0.0"
  },
  "type": "module",
  "main": "src/server.js",
  "imports": {
    "#store/*": "./src/store/*",
    "#utils/*": "./src/utils/*",
    "#atoms/*": "./src/components/atoms/*",
    "#molecules/*": "./src/components/molecules/*",
    "#organisms/*": "./src/components/organisms/*",
    "#templates/*": "./src/components/templates/*",
    "#pages/*": "./src/pages/*"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@techninja/clearstack": "^0.4.21",
    "@types/node": "^22.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^0.11.0",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-unused-imports": "^4.0.0",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.50.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.6.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.2"
  }
}
